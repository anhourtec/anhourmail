# syntax=docker/dockerfile:1.7
# apps/worker — queue worker, scheduler and mail importer (same image, different command). Runs TypeScript via tsx,
# non-root.
# Build from the repo root:  docker build -f deploy/Dockerfile.worker --build-arg GIT_SHA=$(git rev-parse --short HEAD) .
#
#   worker:    CMD ["npm", "run", "--silent", "--workspace", "@anhourmail/worker", "start"]
#   scheduler: command: ["npm", "run", "--silent", "--workspace", "@anhourmail/worker", "scheduler"]
#   importer:  command: ["npm", "run", "--silent", "--workspace", "@anhourmail/worker", "importer"]
#              its own container with NO Stalwart key, Redis or Stalwart HTTP setting, on a network that reaches only
#              Postgres, the mail server's IMAPS port and public TCP 993/143 (ADR-0030; deploy/README.md "Mail
#              importer"); healthcheck `find /tmp/importer-heartbeat -mmin -2`.

ARG NODE_IMAGE=node:22.22.3-alpine3.24

FROM ${NODE_IMAGE} AS runtime
ARG GIT_SHA=unknown
ENV NODE_ENV=production \
    GIT_SHA=${GIT_SHA} \
    LOG_SERVICE=worker
WORKDIR /app
RUN addgroup -S app -g 10001 && adduser -S app -u 10001 -G app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/site/package.json apps/site/
COPY apps/worker apps/worker
COPY packages packages
COPY infra/stalwart/dev-plan.ts infra/stalwart/dev-plan.ts
# Workspace install (tsx is needed at runtime); app build tooling for web/site is not required here.
RUN npm ci --no-audit --no-fund --ignore-scripts --workspace @anhourmail/worker --include-workspace-root \
 && chown -R app:app /app
USER app
# The worker writes a heartbeat file every 30 s; stale for 2 minutes = unhealthy.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD find /tmp/worker-heartbeat -mmin -2 | grep -q . || exit 1
CMD ["npm", "run", "--silent", "--workspace", "@anhourmail/worker", "start"]
