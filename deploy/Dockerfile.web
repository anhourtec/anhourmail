# syntax=docker/dockerfile:1.7
# apps/web — console (app.) + webmail (mail.), Next.js standalone output, non-root.
# Build from the repo root:  docker build -f deploy/Dockerfile.web --build-arg GIT_SHA=$(git rev-parse --short HEAD) .

ARG NODE_IMAGE=node:22.22.3-alpine3.24

FROM ${NODE_IMAGE} AS deps
WORKDIR /repo
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/site/package.json apps/site/
COPY apps/worker/package.json apps/worker/
COPY packages packages
RUN npm ci --no-audit --no-fund --ignore-scripts

FROM deps AS build
ENV NEXT_TELEMETRY_DISABLED=1 \
    APP_PROTOCOL=https
COPY . .
RUN npm run build --workspace @anhourmail/web

FROM ${NODE_IMAGE} AS runtime
ARG GIT_SHA=unknown
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    GIT_SHA=${GIT_SHA} \
    LOG_SERVICE=web
WORKDIR /app
RUN addgroup -S app -g 10001 && adduser -S app -u 10001 -G app
# Standalone output keeps the monorepo layout because outputFileTracingRoot is the repo root.
COPY --from=build --chown=app:app /repo/apps/web/.next/standalone ./
COPY --from=build --chown=app:app /repo/apps/web/.next/static ./apps/web/.next/static
# Next's standalone output leaves out public/ (logos, icons, web manifest); copy it beside the server.
COPY --from=build --chown=app:app /repo/apps/web/public ./apps/web/public
USER app
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=40s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/api/health" || exit 1
CMD ["node", "apps/web/server.js"]
