# AnhourMail — local development. Copy to .env (never commit .env).
# Every value here is a dev placeholder; production secrets live only on the server.

# --- Dev servers (CLAUDE.md rule 18). Apps listen on DEV_HOST (0.0.0.0 = reachable from your LAN).
DEV_HOST=0.0.0.0
# Infra containers (Postgres, Redis, Stalwart, Mailpit) hold dev passwords: loopback by default.
# Set to 0.0.0.0 only if you deliberately want them on your LAN.
DEV_BIND_ADDRESS=127.0.0.1

# --- Dev ports: uncommon 43xxx block, except mail protocols, which use the real standard ports so mail
# clients are tested exactly as in production (CLAUDE.md rule 18). Check with `npm run ports:check`.
WEB_DEV_PORT=43200
SITE_DEV_PORT=43100
WEBMAIL_DEV_PORT=43300
POSTGRES_HOST_PORT=43432
REDIS_HOST_PORT=43379
STALWART_HTTP_PORT=43080
STALWART_SMTP_PORT=25
STALWART_SUBMISSIONS_PORT=465
STALWART_SUBMISSION_PORT=587
STALWART_IMAP_PORT=143
STALWART_IMAPS_PORT=993
STALWART_POP3_PORT=110
STALWART_POP3S_PORT=995
STALWART_SIEVE_PORT=4190
MAILPIT_SMTP_PORT=43125
MAILPIT_UI_PORT=43026

# --- Postgres (control plane only — never mail content)
POSTGRES_USER=anhourmail
POSTGRES_PASSWORD=anhourmail_dev_password
POSTGRES_DB=anhourmail
DATABASE_URL=postgres://anhourmail:anhourmail_dev_password@127.0.0.1:43432/anhourmail
# Separate database for integration tests (created by the compose init script)
TEST_DATABASE_URL=postgres://anhourmail:anhourmail_dev_password@127.0.0.1:43432/anhourmail_test

# --- Redis (sessions, queues, rate limits, cache)
REDIS_PASSWORD=anhourmail_dev_redis
REDIS_URL=redis://:anhourmail_dev_redis@127.0.0.1:43379/0

# --- Stalwart (dev). The recovery admin is a dev-only convenience and is NEVER set in production
# (docs/internal/research/stalwart.md §2). The control plane uses an API key in production.
STALWART_URL=http://127.0.0.1:43080
STALWART_DEV_ADMIN_USER=admin
STALWART_DEV_ADMIN_PASSWORD=anhourmail-dev-admin-7Qe2
# Seeded dev mailboxes (dev.test). Strong enough for Stalwart's zxcvbn check; dev only.
DEV_MAILBOX_PASSWORD=Dev-mailbox-pass-4471!

# --- App (dev: everything on localhost, one port per app; production uses app./mail. hostnames)
APP_PROTOCOL=http
APP_URL=http://localhost:43200
WEBMAIL_URL=http://localhost:43300
SITE_URL=http://localhost:43100
WEB_INTERNAL_URL=http://127.0.0.1:43200
# Console session signing secret. Dev placeholder; production uses 32+ random bytes from the private ops repo.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
# Self-service sign-up: open | closed. Open while the app is reachable only from allow-listed IPs (firewall on
# 443); closed once invite-only sign-up ships (docs/internal/08-operations.md "Access control").
SIGNUP_MODE=open
# Transactional mail (password resets, invites). Dev: Mailpit — nothing leaves the machine. Production: submission
# to our Stalwart as the no-reply mailbox (credentials in the private ops repo).
MAIL_TRANSPORT_URL=smtp://127.0.0.1:43125
MAIL_FROM="AnhourMail <no-reply@anhourmail.test>"
# Dev/test only: multiplies rate limits so the RBAC harness and e2e can run repeatedly (ignored in production).
RATE_LIMIT_MULTIPLIER=20
# Seed: the platform Global Administrator created by `npm run db:seed` (password is generated and written
# to credentials.md, never stored here).
SEED_PLATFORM_ADMIN_EMAIL=admin@anhourtec.test
SEED_PLATFORM_ADMIN_NAME="Platform Admin"
LOG_LEVEL=info
LOG_PRETTY=true
# Only trust X-Forwarded-For when a proxy we control sets it (NGINX in production).
TRUST_PROXY=false
NEXT_TELEMETRY_DISABLED=1
