# AnhourMail — local development. Copy to .env (never commit .env).
# Every value here is a dev placeholder; production secrets live only on the server.

# --- Dev servers (CLAUDE.md rule 18). Apps listen on DEV_HOST (0.0.0.0 = reachable from your LAN).
DEV_HOST=0.0.0.0
# Infra containers (Postgres, Redis, Stalwart, Mailpit) hold dev passwords: loopback by default.
# Set to 0.0.0.0 only if you deliberately want them on your LAN.
DEV_BIND_ADDRESS=127.0.0.1

# --- Dev ports: uncommon 43xxx block, except mail protocols, which use the real standard ports so mail
# clients are tested exactly as in production (CLAUDE.md rule 18). Check with `npm run ports:check`.
WEB_DEV_PORT=43200
SITE_DEV_PORT=43100
WEBMAIL_DEV_PORT=43300
POSTGRES_HOST_PORT=43432
REDIS_HOST_PORT=43379
STALWART_HTTP_PORT=43080
STALWART_SMTP_PORT=25
STALWART_SUBMISSIONS_PORT=465
STALWART_SUBMISSION_PORT=587
STALWART_IMAP_PORT=143
STALWART_IMAPS_PORT=993
STALWART_POP3_PORT=110
STALWART_POP3S_PORT=995
STALWART_SIEVE_PORT=4190
MAILPIT_SMTP_PORT=43125
MAILPIT_UI_PORT=43026

# --- Postgres (control plane only — never mail content)
POSTGRES_USER=anhourmail
POSTGRES_PASSWORD=anhourmail_dev_password
POSTGRES_DB=anhourmail
DATABASE_URL=postgres://anhourmail:anhourmail_dev_password@127.0.0.1:43432/anhourmail
# Separate database for integration tests (created by the compose init script)
TEST_DATABASE_URL=postgres://anhourmail:anhourmail_dev_password@127.0.0.1:43432/anhourmail_test

# --- Redis (sessions, queues, rate limits, cache)
REDIS_PASSWORD=anhourmail_dev_redis
REDIS_URL=redis://:anhourmail_dev_redis@127.0.0.1:43379/0

# --- Stalwart (dev). The recovery admin is a dev-only convenience and is NEVER set in production
# (docs/internal/research/stalwart.md §2); in development it stands in for all five management keys. Production gives
# each process only its own key (ADR-0020 "Credential split"; deploy/README.md): STALWART_OPERATIONS_KEY to web,
# STALWART_PROVISIONING_KEY to worker and scheduler, STALWART_AUDIT_KEY to the scheduler, STALWART_TRAINING_KEY to the
# worker (spam-training samples a mail import created), STALWART_HOLD_KEY to worker and scheduler (the relay hold's
# list). Set them here only to try real keys locally; STALWART_API_KEY is no longer used and is refused.
STALWART_URL=http://127.0.0.1:43080
STALWART_DEV_ADMIN_USER=admin
STALWART_DEV_ADMIN_PASSWORD=anhourmail-dev-admin-7Qe2
# Mailbox password grants (web app + production management proxy only; never the worker). Unset in dev: there's no
# proxy. Required in production (32+ characters; deploy/README.md).
# MAILBOX_PASSWORD_GRANT_KEY=
# Mail importer (ADR-0030; `npm run dev` runs it). Outside production it only ever reads from the dev mail server:
# IMPORT_DEV_ALLOW_SOURCES defaults to 127.0.0.1/localhost/import-edge on 993 and 143, and the destination to
# 127.0.0.1:$STALWART_IMAPS_PORT with the dev certificate accepted. Message caps per mailbox over 30 days by trust tier (production
# requires new, standard and restricted; empty here = no cap):
# IMPORT_MESSAGE_CAPS=new=<n>,standard=<n>,restricted=0
# Trust promotion (ADR-0034 §2; the scheduler's hourly job:trust-promote moves established accounts in good standing
# from new to standard). Development values only: they promote within an hour. Production refuses to start without all
# three; its values are private and live in the ops repository. Unset all three here to turn the job off.
TRUST_PROMOTE_MIN_AGE_HOURS=1
TRUST_PROMOTE_MAX_HELD=1000
TRUST_PROMOTE_BATCH=100
# Send on behalf (ADR-0026): the key behind the webmail's on-behalf tag, shared only with the mail server's
# sender-identity script (web app + Stalwart only; never the worker). Leave unset in dev: the dev plan (`npm run
# db:seed`) and the web app both derive the same dev key from BETTER_AUTH_SECRET. Production: 64 lowercase hex
# characters (openssl rand -hex 32) from the private ops repo. If you set it here, re-run `npm run db:seed`.
# SENDER_DELEGATION_KEY=
# Seeded dev mailboxes (dev.test). Strong enough for Stalwart's zxcvbn check; dev only.
DEV_MAILBOX_PASSWORD=Dev-mailbox-pass-4471!

# --- App (dev: everything on localhost, one port per app; production uses app./mail. hostnames)
APP_PROTOCOL=http
APP_URL=http://localhost:43200
WEBMAIL_URL=http://localhost:43300
SITE_URL=http://localhost:43100
# The deployment's own domain: MX, SPF include, DKIM targets, IMAP/SMTP/JMAP hosts and the console's mail-app
# settings are built under it (mx1.<domain>, _spf.<domain>, …). Unset = anhourmail.com (development only). Production
# must set it explicitly (web and worker refuse to start otherwise), with APP_URL and WEBMAIL_URL at app.<domain> and
# mail.<domain>. Development leaves it unset or uses a .test domain: `npm run db:seed` refuses any other value.
# PLATFORM_DOMAIN=
# The hostname(s) our mail server stamps on Authentication-Results (comma-separated). The webmail's "Show original"
# trusts SPF/DKIM/DMARC results only from these. Unset = mx1.<platform domain>, plus mail.dev.test in development.
# MAIL_AUTHSERV_ID=
WEB_INTERNAL_URL=http://127.0.0.1:43200
# Console session signing secret. Dev placeholder; production uses 32+ random bytes from the private ops repo.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
# Secrets-at-rest key ring (webmail session tokens; CLAUDE.md rule 16): "id:base64(32 random bytes)[,older…]",
# first = active. Leave empty in dev (a dev key is derived from BETTER_AUTH_SECRET); required in production.
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEYRING=
# Self-service sign-up: open | closed. Open while the app is reachable only from allow-listed IPs (firewall on
# 443); closed to turn self-service sign-up off (docs/internal/08-operations.md "Access control").
SIGNUP_MODE=open
# Sign-up proof-of-work (ADR-0031): the browser finds a hash with this many leading zero bits before an account is
# created (8–26; unset = 17, about a second on a mid-range phone). Then sign-up attempts per client address (IPv6: per
# /64) per hour, and accounts created per address and per network (IPv4 /24, IPv6 /64 per hour and per day, IPv6 /56
# and /48 per day); unset = the defaults in docs/internal/rate-limits.md (`signup*`). Production values live in the
# private ops repo.
SIGNUP_POW_BITS=
SIGNUP_LIMIT_ATTEMPTS_HOUR=
SIGNUP_LIMIT_ADDRESS_HOUR=
SIGNUP_LIMIT_ADDRESS_DAY=
SIGNUP_LIMIT_NETWORK_HOUR=
SIGNUP_LIMIT_NETWORK_DAY=
SIGNUP_LIMIT_NETWORK56_DAY=
SIGNUP_LIMIT_NETWORK48_DAY=
# Breached-password check for new console and mailbox passwords: on | off | fake. `on` sends only the first five
# characters of the password's SHA-1 hash to the public Pwned Passwords range API from the server (never the password)
# and fails open when it can't be reached; `fake` refuses a short fixed list without the network (CI sets it in
# .cicd/lib.sh); unset = on (off under NODE_ENV=test). Production refuses `fake`.
BREACHED_PASSWORD_CHECK=on
# Disposable email (ADR-0033): sign-up, people invites and forwarding targets refuse temporary-inbox addresses (the
# vendored domain list, plus a DNS check of the domain's mail servers that fails open). Extra domains to refuse, and
# domains to accept despite the list; comma- or space-separated, blank = none.
DISPOSABLE_EXTRA_DOMAINS=
DISPOSABLE_ALLOW_DOMAINS=
# Transactional mail (password resets). Dev: Mailpit — nothing leaves the machine. Production: submission
# to our Stalwart as the no-reply mailbox (credentials in the private ops repo).
MAIL_TRANSPORT_URL=smtp://127.0.0.1:43125
MAIL_FROM="AnhourMail <no-reply@anhourmail.test>"
# Billing (ADR-0029 §3): off | fake | stripe. Unset = fake outside production, off in production; production refuses
# fake. The fake keeps its state in Redis and needs nothing else. With stripe, every STRIPE_* below except the portal id
# is required; the key's mode must match NODE_ENV (a live key only in production; BILLING_ALLOW_TEST_KEYS=true lets
# pre-staging run a test key). Real values live in your local .env or the private ops repo's secret store, never here.
BILLING_PROVIDER=fake
BILLING_ALLOW_TEST_KEYS=
# A restricted key (rk_…): Customers, Checkout Sessions, Customer Portal, Subscriptions, Invoices (read),
# Prices/Products (read), Refunds, Events (read).
STRIPE_SECRET_KEY=
# Webhook signing secret(s), comma-separated during a rotation (any one verifies).
STRIPE_WEBHOOK_SECRET=
# Price id lists, comma-separated: first = current, the rest = legacy prices still accepted.
STRIPE_PRICE_PLUS=
STRIPE_PRICE_STORAGE_BLOCK=
STRIPE_PRICE_EXTRA_MAILBOX=
# Product id for the Supporter plan's inline (pay-what-you-want) prices.
STRIPE_PRODUCT_SUPPORTER=
# Optional Customer Portal configuration id.
STRIPE_PORTAL_CONFIGURATION=
# Most mailboxes + aliases + masked aliases one account may hold (an abuse ceiling, never published). Required in
# production (value in the private ops repo); unset in dev = 5000. Support raises it per account.
ACCOUNT_ADDRESS_CEILING=
# Dev/test only: multiplies rate limits so the RBAC harness and e2e can run repeatedly (ignored in production).
RATE_LIMIT_MULTIPLIER=20
# Seed (dev/CI only; refuses under NODE_ENV=production — servers use job:bootstrap-admin): the platform Global
# Administrator created by `npm run db:seed` (password is generated and written
# to credentials.md, never stored here).
SEED_PLATFORM_ADMIN_EMAIL=admin@anhourtec.test
SEED_PLATFORM_ADMIN_NAME="Platform Admin"
LOG_LEVEL=info
LOG_PRETTY=true
# Trust X-Forwarded-For only when a proxy we control sets it. Dev: true — the webmail port forwarder
# (scripts/dev-mail-proxy.mjs) sets it for each visitor, and direct hits on the app port come from this machine
# (DEV_HOST is loopback by default). The webmail then forwards each visitor's address to Stalwart, so failed
# sign-ins are counted per visitor and the shared mail-edge forwarder is never banned. Production sets its own
# value in the private ops config (true behind NGINX, which overwrites the header).
TRUST_PROXY=true
NEXT_TELEMETRY_DISABLED=1

# Worker: infrastructure domains that exist only on the mail server (never reported as drift).
RECONCILE_IGNORE_DOMAINS=dev.test
